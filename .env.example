# Copy to .env for local use or .env.production for production Compose.
# Never commit real secrets. Secret file paths are used by production Compose.
DEMO_MODE=true
OPENAI_API_KEY=
OPENAI_API_KEY_FILE=
OPENAI_MODEL=gpt-4o-mini
OPENAI_INPUT_COST_PER_MILLION=0.15
OPENAI_OUTPUT_COST_PER_MILLION=0.60
DAILY_BUDGET_USD=10
WEEKLY_BUDGET_USD=50

# SQLite is the local development default; production Compose uses PostgreSQL.
DATABASE_URL=sqlite:///./data/nordly.db
KNOWLEDGE_BASE_PATH=./knowledge_base
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

APP_IMAGE=nordly-support-agent:local
APP_BIND_ADDRESS=127.0.0.1
APP_PORT=8000
POSTGRES_DB=nordly
POSTGRES_USER=nordly
MONITORING_BIND_ADDRESS=127.0.0.1
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
ALERTMANAGER_PORT=9093
GRAFANA_ADMIN_USER=admin

POSTGRES_PASSWORD_FILE=./secrets/postgres_password.txt
JWT_SECRET_FILE=./secrets/jwt_secret.txt
BOOTSTRAP_ADMIN_USERNAME=
BOOTSTRAP_ADMIN_TENANT=
BOOTSTRAP_ADMIN_PASSWORD_FILE=./secrets/bootstrap_admin_password.txt
GRAFANA_ADMIN_PASSWORD_FILE=./secrets/grafana_admin_password.txt
ENCRYPTION_KEY_FILE=./secrets/encryption_key.txt
METRICS_TOKEN_FILE=./secrets/metrics_token.txt

# PostgreSQL encrypted backups. Keep the age private identity off this host.
BACKUP_AGE_RECIPIENT=
BACKUP_DIRECTORY=./backups
BACKUP_RETENTION_DAYS=30
BACKUP_INTERVAL_SECONDS=86400

# Staging only; CI creates every referenced temporary secret file.
STAGING_PORT=18000
STAGING_OPENAI_API_KEY_FILE=./secrets/staging_openai_api_key.txt
STAGING_POSTGRES_PASSWORD_FILE=./secrets/staging_postgres_password.txt
STAGING_JWT_SECRET_FILE=./secrets/staging_jwt_secret.txt
STAGING_BOOTSTRAP_ADMIN_PASSWORD_FILE=./secrets/staging_bootstrap_admin_password.txt
STAGING_ENCRYPTION_KEY_FILE=./secrets/staging_encryption_key.txt
STAGING_METRICS_TOKEN_FILE=./secrets/staging_metrics_token.txt
